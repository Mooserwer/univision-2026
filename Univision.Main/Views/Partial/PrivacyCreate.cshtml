@model Univision.Main.Models.Api.ResponsePrivacyAgree
@{
  ViewBag.Title = "헤드헌팅 Pro 내부인재풀 개인정보 동의";
  ViewBag.NoMenu = true;
  Layout = "~/Views/Shared/_Layout.cshtml";

  string paramError = ViewBag.ParamError as string;
  string fixedSendNumber = "02-551-2300";
  string fixedSendEmail = "lee.hc@unicosearch.com";

  // PrivacyCreateTest 공용: 테스트 테이블 저장 + 테스트 수신처 고정 발송
  bool isTest = ViewBag.IsTest != null && (bool)ViewBag.IsTest;
  if (isTest) { ViewBag.Title = "[테스트] " + ViewBag.Title; }
  string sendAction = isTest ? "CreateNPrivacyTest" : "CreateNPrivacy";
}

<div class="p-10">
  <!-- 상단 헤더 -->
  <div class="panel bg-blue-600">
    <div class="panel-body text-center py-20">
      <h3 class="text-white m-0"><i class="fas fa-user-shield" aria-hidden="true"></i> @(isTest ? "[테스트] " : "")헤드헌팅 Pro 내부인재풀 개인정보 동의</h3>
    </div>
  </div>

  @if (isTest)
  {
    <div class="alert alert-warning">
      <i class="fas fa-flask" aria-hidden="true"></i> 테스트 페이지입니다. 입력한 연락처와 무관하게 테스트 수신처로 발송되며, 테스트 데이터로 저장됩니다.
    </div>
  }

  @if (!String.IsNullOrEmpty(paramError))
  {
    <div class="alert alert-danger">
      <i class="fas fa-exclamation-triangle" aria-hidden="true"></i> @paramError
      <div class="mt-5"><small>필수 파라미터: name(이름), phone 또는 email 중 하나, id(아이디)</small></div>
    </div>
  }

  @using (Html.BeginForm("CreatePrivacy", "Partial", FormMethod.Post, new { @class = "", @id = "PrivacyCreateForm" }))
  {
    <div class="panel">
      <div class="panel-body">
        <div class="row">
          <div class="col-12 form-group">
            <label class="form-control-label h4"> <i class="fas fa-send" aria-hidden="true"></i>동의 항목<span class="label-reqired">*</span></label>

            <div class="cont pl-10">

              <div class="checkbox-custom checkbox-primary">
                <input type="checkbox" id="privacy" name="privacy" value="1" @(Model.is_privacy_agree == 1 ? "checked" : "")>
                <label for="privacy">개인정보 수집·이용에 대한 동의 (이력서 요청 시)</label>
              </div>
              <div class="row">
                <div class="col-12">
                  @Html.TextArea("privacy_txt", @"1.	수집하는 개인정보 항목 : 이름, 연락처, 이메일, 주소, 생년월일, 성별, 학력사항, 경력사항, 자격사항, 병역정보, 이력서 및 경력기술서에 본인이 기재한 사항과 본인이 제출한 정보.

2.	개인정보의 수집 및 이용 목적 : 채용 전형 진행, 채용 관련 상담 및 안내, 인재풀 등록

3.	개인정보의 보유 및 이용 기간 : 수집한 개인 정보는 상시 채용을 목적으로 보관하며, 처리 목적 달성시까지 보유한다. 단 정보 주체의 파기 요청이 있는 경우, 지체 없이 파기한다.

4.	동의를 거부할 권리 및 동의 거부에 따른 불이익 : 개인정보 수집 및 이용 등과 관련한 위 사항에 대하여 동의를 거부할 수 있습니다. 다만, 동의하지 않을 경우 채용 관련 서비스 및 인재풀 등록에 제한이 있을 수 있습니다.", new { @class = "text-info form-control pl-20", @readonly = "true", @placeholder = "", @rows = 7 })
                </div>
              </div>
              <div class="checkbox-custom checkbox-primary">
                <input type="checkbox" id="provide3rd" name="provide3rd" value="2" @(Model.is_provide_agree == 1 ? "checked" : "")>
                <label for="provide3rd">
                  개인정보 제3자 제공에 대한 동의 (고객사에 추천 시)
                </label>
              </div>
              <div id="provide3rd_div">
                <div class="row">
                  <div class="col-12">
                    @Html.TextArea("provide3rd_txt", @"1.	제공받는 자 : 채용 회사

2.	제공 목적 : 채용 전형 진행, 후보자 정보 확인 및 검증.

3.	제공하는 항목 : 이름, 연락처, 이메일, 주소, 생년월일, 성별, 학력사항, 경력사항, 자격사항, 병역정보, 이력서 및 경력기술서에 본인이 기재한 사항과 본인이 제출한 정보.

4.	제공받는 자의 보유 및 이용 기간 : 개인정보의 이용 목적 달성 시, 즉시 파기합니다.

5.	동의를 거부할 권리 및 동의 거부에 따른 불이익 : 개인정보 제3자 제공과 관련한 위 사항에 대하여 동의를 거부할 수 있습니다. 다만 동의하지 않을 경우 채용 관련 서비스 이용에 제한이 있을 수 있습니다.", new { @class = "text-info form-control pl-20", @readonly = "true", @placeholder = "", @rows = 8 })
                  </div>
                </div>

              </div>

            </div>
          </div>
        </div>
      </div>
    </div>
    <hr />
    <div class="panel">
      <div class="panel-body">
        <label class="h4"> <i class="fas fa-send" aria-hidden="true"></i>수신자 정보</label>
        <div class="row">
          <div class="col-12 form-group">
            <label class="form-control-label"> <i class="fas fa-send" aria-hidden="true"></i>받는사람 (정보주체)</label>
            <div class="cont2 row">
              <div class="ad_list px-5" style="min-height:53.6px;">
                @if (Model.receive.Count > 0)
                {
                  foreach (var r_info in Model.receive)
                  {
                    <div class="receive_div border p-3 mb-1" data-c_seq="@r_info.c_seq" data-can_type="@r_info.can_type" data-can_name="@r_info.can_name" data-can_addr="@r_info.can_addr" data-can_phone="@r_info.can_phone" data-can_email="@r_info.can_email">
                      <span class="can_name pl-5">@r_info.can_name</span> : <span class="can_addr pl-5">@r_info.can_addr</span>
                      @if (r_info.can_type == "EMAIL")
                      {
                        <span class="text-primary ml-5">(이메일 발송 시에는 @fixedSendEmail 로 고정 발송됩니다.)</span>
                      }
                      else
                      {
                        <span class="text-primary ml-5">(문자 발송 시 발신번호는 @fixedSendNumber 으로 고정 발송됩니다.)</span>
                      }
                    </div>
                  }
                }
                else
                {
                  <div class="text-muted p-3">표시할 수신자 정보가 없습니다. (파라미터를 확인하세요.)</div>
                }
              </div>
            </div>
          </div>


          @* 발신번호는 02-551-2300 고정 (히든). 발송 안내는 수신자 라인에 인라인으로 표시됨. *@
          @Html.Hidden("send_number", fixedSendNumber)

          <div class="col-12 form-group">
            <div class="cont3">
              <div class="col-md-12 float-right custom5">
                <button class="btn btn-default btn-outline" type="button" id="btnSmsModalClose">취소</button>
                <button class="btn btn-primary btn-outline ed" id="btnSendSms" type="button">보내기</button>
              </div>
            </div>
            <div class="clearfix"></div>
          </div>
        </div>
      </div>
    </div>
  }
</div>

@section scripts{
  <script type="text/javascript">
    function agree_show_hide(id, target_id) {
      if ($(id).prop("checked")) {
        $(target_id).show();
      } else {
        $(target_id).hide();
      }
    }

    $('#privacy').click(function () {
      agree_show_hide('#privacy', '#privacy_txt');
    });

    $('#provide3rd').click(function () {
      agree_show_hide('#provide3rd', '#provide3rd_div');
    });

    agree_show_hide('#privacy', '#privacy_txt');
    agree_show_hide('#provide3rd', '#provide3rd_div');

    var profileId = '@ViewBag.ParamId';

    // 발송 완료 후 탭 닫기 (헤드헌팅 Pro 에서 새 탭으로 열림)
    // 브라우저 정책상 닫을 수 없는 탭이면 직접 닫도록 안내
    function closeTab(fallbackMsg) {
      window.close();
      setTimeout(function () {
        if (!window.closed) {
          NormalAlert(fallbackMsg || "발송이 완료되었습니다. 이 탭을 직접 닫아주세요.");
        }
      }, 300);
    }

    // 취소 → 탭 닫기
    $("#btnSmsModalClose").click(function () {
      closeTab("이 탭을 직접 닫아주세요.");
    });

    // 보내기 → 동의서 발송(내부+홈페이지 저장 + SMS/Email)
    $("#btnSendSms").click(function () {
      if (!$('#privacy').prop("checked") && !$('#provide3rd').prop("checked")) {
        ErrorAlert("발송할 동의 항목을 1개 이상 선택하세요.");
        return false;
      }

      // 단일 수신자 (파라미터로 렌더된 1명)
      var $item = $(".ad_list .receive_div").first();
      if ($item.length === 0) {
        ErrorAlert("수신자 정보가 없습니다. (파라미터를 확인하세요.)");
        return false;
      }
      var receive_info = [{
        c_seq: 0,
        can_type: $item.data("can_type"),
        can_name: $item.data("can_name"),
        can_addr: $item.data("can_addr")
      }];

      ConfirmAlert('동의서 발송', '동의서를 발송 하시겠습니까?', function () {
        var currentData = {
          is_privacy_agree: $('#privacy').prop("checked") ? 1 : 0,
          privacy_text: $('#privacy').prop("checked") ? $('#privacy_txt').val() : "",
          is_provide_agree: $('#provide3rd').prop("checked") ? 1 : 0,
          provide_text: $('#provide3rd').prop("checked") ? $('#provide3rd_txt').val() : "",
          client_seq: -1,
          client_name: "유니코써치에서 제안한 입사 지원 기업",
          send_phone: $("#send_number").val(),
          receive: receive_info
        };

        // 중복 발송 방지: 발송 시작 시 비활성화, 실패 시에만 다시 활성화
        $("#btnSendSms").prop("disabled", true);

        $.ajax({
          url: '@Url.Action(sendAction, "Partial")',
          type: "POST",
          dataType: 'json',
          data: { data: currentData, profile_id: profileId },
          beforeSend: function () { showLoading(); },
          success: function (json) {
            hideLoading();
            if (json.ok) {
              $("#btnSendSms").text("발송완료");
              NormalAlert(json.message, closeTab);
            } else {
              $("#btnSendSms").prop("disabled", false);
              ErrorAlert(json.message);
            }
          },
          error: function () {
            hideLoading();
            $("#btnSendSms").prop("disabled", false);
            ErrorAlert("알 수 없는 오류가 발생 했습니다.");
          }
        });
      });
    });
  </script>
}
